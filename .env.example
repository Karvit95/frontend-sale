# URL base per le chiamate API verso il backend (default: /api)
VITE_API_BASE_URL=/api

# Ruolo Microsoft Entra ID per l'accesso amministrativo nella UI
# NOTA DI SICUREZZA: Questa variabile controlla esclusivamente la visibilità dei controlli e pulsanti
# nell'interfaccia utente (es. pulsante "Nuova Prenotazione").
# L'autorizzazione reale per tutte le operazioni protette (creazione, modifica, cancellazione)
# viene SEMPRE verificata e garantita dal backend Spring Boot tramite la proprietà app.admin-role.
VITE_ADMIN_ROLE=RoomBooking.Admin
